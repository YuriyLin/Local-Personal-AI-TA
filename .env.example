# Loopback by default. Non-loopback requires a token and an HTTPS public origin.
HOST=127.0.0.1
PORT=3000
BIIBO_ACCESS_TOKEN=
BIIBO_PUBLIC_ORIGIN=
ENABLE_MASCOT_GENERATION=false

# Local model servers
OLLAMA_URL=http://127.0.0.1:11434
LMSTUDIO_URL=http://127.0.0.1:1234

# Local MinerU PDF / Image OCR service
AITA_MINERU_URL=http://127.0.0.1:8000

# Cloud AI provider API keys (server-side only; configure the providers you plan to use)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional trusted HTTPS gateway for the Claude API
ANTHROPIC_BASE_URL=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
